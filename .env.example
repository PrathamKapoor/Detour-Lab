# DETOUR LAB - example environment file.
# Copy to .env and adjust locally. NEVER commit a filled-in .env.
# The R0/R1 demo requires NO API keys, no external services and no secrets.

# Backend
DETOUR_LAB_API_HOST=127.0.0.1
DETOUR_LAB_API_PORT=8077
DETOUR_LAB_LOG_LEVEL=info
# Directory for the local SQLite database (created by Gate 2 migrations).
DETOUR_LAB_DATA_DIR=./var

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8077

# No LLM/API keys are used anywhere in the authoritative evaluation path.
# Any future advisory-model integration must be optional and out of the
# safety-critical path (PRD R2), and must never receive API keys in R0/R1.